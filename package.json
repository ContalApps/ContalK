{
  "name": "contalk",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron": "npm run build:audio && vite build && electron-builder --win --publish never",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:audio": "node scripts/build-audio.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json",
    "verify": "npm run typecheck && npm test",
    "publish:electron": "node scripts/publish-electron.mjs"
  },
  "build": {
    "appId": "com.contalk.app",
    "productName": "ContalK",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src-tauri/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ContalK"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sartervitor",
        "repo": "ContalK",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "native/bin/contalk-audio.exe",
        "to": "audio/contalk-audio.exe"
      }
    ],
    "artifactName": "ContalK-Setup-${version}.${ext}"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.24",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.15.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
