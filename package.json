{
  "name": "contalk",
  "private": true,
  "version": "0.1.25",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:electron": "npm run build:audio && npm run build:voice-input && vite build && electron-builder --win --publish never",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:audio": "node scripts/build-audio.mjs",
    "build:voice-input": "node scripts/build-voice-input.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json",
    "verify": "npm run typecheck && npm test",
    "publish:electron": "node scripts/publish-electron.mjs",
    "storage:login": "node --env-file=.env.storage scripts/telegram-storage-server.mjs login",
    "storage:start": "node --env-file=.env.storage scripts/telegram-storage-server.mjs",
    "community:start": "node --env-file=.env.community scripts/community-server.mjs",
    "community:setup": "node scripts/community-setup.mjs"
  },
  "build": {
    "appId": "com.contalk.app",
    "productName": "ConTALK",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "!node_modules/mediasoup{,/**/*}"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src-tauri/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ConTALK",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ContalApps",
        "repo": "ContalK",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "native/bin/contalk-voice-input.exe",
        "to": "voice-input/contalk-voice-input.exe"
      },
      {
        "from": "native/bin/contalk-audio.exe",
        "to": "audio/contalk-audio.exe"
      },
      {
        "from": "native/bin/contalk-update.exe",
        "to": "update/contalk-update.exe"
      }
    ],
    "artifactName": "ConTALK-Setup-${version}.${ext}",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ]
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.2",
    "lucide-react": "^1.61.0",
    "mediasoup": "^3.31.0",
    "mediasoup-client": "^3.25.3",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.15.1",
    "tailwind-merge": "^3.7.0",
    "telegram": "^2.26.22",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
