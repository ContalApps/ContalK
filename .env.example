# Accounts are created in the app; no personal keys or storage service to configure.
CONTALK_COMMUNITY_HOST=0.0.0.0
CONTALK_COMMUNITY_PORT=8789
CONTALK_COMMUNITY_DATA=/app/data
# Per-person upload quota; uploads also stop while less than 2 GB would stay free on the disk.
CONTALK_FILE_QUOTA_MB=5120
# WebSocket served by the SAME community container and proxy.
CONTALK_REALTIME_URL=wss://comunidade.contalapps.com.br/realtime
CONTALK_MEDIA_PUBLIC_IP=74.0.5.249
CONTALK_MEDIA_PORT=40000
# Enable only when coturn joins the same dedicated Docker network as the SFU.
CONTALK_MEDIA_EXPOSE_INTERNAL_IP=false
# Same random secret only in community and coturn; never in desktop/VITE_.
CONTALK_TURN_URLS=turn:74.0.5.249:3478?transport=udp,turn:74.0.5.249:3478?transport=tcp
CONTALK_TURN_SECRET=
# Optional, only in coturn: dedicated SFU Docker IPv4 range for local hairpin NAT.
# Verify the real subnet before setting; never allow all private IPv4 ranges.
CONTALK_TURN_PRIVATE_PEER_RANGE=
CONTALK_COMMUNITY_NETWORK=
# Only for migrating to Compose: exact existing persistent volume name, never create a replacement.
CONTALK_EXISTING_COMMUNITY_VOLUME=
