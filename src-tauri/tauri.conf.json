{
  "productName": "ContalK",
  "version": "0.1.3",
  "identifier": "com.contalk.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ContalK",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFNzc3RTIxQUQ0ODY4RDYKUldUV2FFaXRJWDUzcmxmTTFiWVhSK1lWN1JqcUZuN3h3UDlYMFRCTjhFZmFkVHJUOTQ2b0p5SHcK",
      "endpoints": [
        "https://github.com/sartervitor/ContalK/releases/latest/download/latest.json"
      ]
    }
  }
}